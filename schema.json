{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "vva 配置",
  "description": "vva (Vendor-Versatile Agent Harness) 配置文件。支持 JSON 与 JSONC（允许注释）；字符串中的 ${VAR} 展开为环境变量。字段详情见 docs/config-reference.md。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "指向本 schema 的路径或 URL，供编辑器补全与校验；解析时忽略"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "string",
          "description": "缺省模型规格 {provider_id}/{model_id}；未指定 --model 且无运行时记忆时使用"
        },
        "small_model": {
          "type": "string",
          "description": "会话标题生成用的小模型规格，缺省时沿用主模型"
        },
        "editor": {
          "enum": ["replace", "patch", "hashline"],
          "default": "hashline",
          "description": "模型未声明 annotation.editor 时的缺省文件编辑协议"
        },
        "web": {
          "type": "object",
          "additionalProperties": false,
          "description": "外置 web search / fetch 补全：模型原生能力缺位时以客户端工具补齐。local 为内置 fetch provider，无需声明",
          "properties": {
            "provider": {
              "type": "object",
              "additionalProperties": false,
              "description": "外置 provider 声明，键为 provider 名",
              "properties": {
                "zhipu": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "智谱 Web Search API / Coding Plan Search MCP，仅支持 search",
                  "properties": {
                    "api_key": { "type": "string", "description": "必填，推荐 \"${ZHIPU_API_KEY}\" 插值；search_mcp 使用 Coding Plan Key" },
                    "search_engine": {
                      "enum": ["search_std", "search_pro", "search_pro_sogou", "search_pro_quark", "search_mcp"],
                      "default": "search_std",
                      "description": "搜索引擎；search_mcp 使用 Coding Plan 联网搜索 MCP"
                    }
                  }
                },
                "deepseek": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "DeepSeek Search / Fetch API，search 与 fetch 均支持",
                  "properties": {
                    "api_key": { "type": "string", "description": "必填，推荐 \"${DEEPSEEK_API_KEY}\" 插值" },
                    "api_base": { "type": "string", "default": "https://api.deepseek.com", "description": "可选根地址，去掉末尾 / 后自动拼接 /v1/tools/search 或 /v1/tools/fetch" }
                  }
                },
                "brave": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Brave Search LLM Context，仅支持 search",
                  "properties": {
                    "api_key": { "type": "string", "description": "必填，推荐 \"${BRAVE_API_KEY}\" 插值" }
                  }
                },
                "tavily": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Tavily API，search 与 fetch 均支持",
                  "properties": {
                    "api_key": { "type": "string", "description": "必填，推荐 \"${TAVILY_API_KEY}\" 插值" }
                  }
                }
              }
            },
            "search": {
              "enum": ["brave", "tavily", "deepseek", "zhipu"],
              "description": "web search 使用的 provider 名"
            },
            "fetch": {
              "enum": ["brave", "local", "tavily", "deepseek"],
              "description": "web fetch 使用的 provider 名；local 为内置网页正文提取（Readability 式），仅支持 fetch"
            }
          }
        },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "description": "agent space（常驻 IM agent）；vva agent 要求声明。router 复用 small_model",
          "properties": {
            "model": { "type": "string", "description": "oneshot 与 topic session 的模型规格，缺省沿用 settings.default" },
            "curator_model": { "type": "string", "description": "curator 独立模型规格；省略时跟随当前 agent 模式模型，配置后不受 /model 切换影响" },
            "ttl_secs": { "type": "integer", "minimum": 0, "default": 18000, "description": "普通 session 空闲清理时长（秒）" },
            "oneshot_ttl_secs": { "type": "integer", "minimum": 0, "default": 0, "description": "oneshot 回复后清理等待时长（秒），0 为回复完即可清理" },
            "rollover_reserve_tokens": { "type": "integer", "minimum": 0, "default": 32000, "description": "上下文达到 limit.context - 预留 时触发 rollover" },
            "pending_files_ttl_secs": { "type": "integer", "minimum": 0, "default": 600, "description": "待附件缓冲等待时长（秒）" },
            "task_timeout_secs": { "type": "integer", "minimum": 1, "default": 600, "description": "定时任务单次执行超时（秒），超时中止并计为失败" },
            "task_max_failures": { "type": "integer", "minimum": 1, "default": 3, "description": "定时任务连续失败多少次后自动停用" },
            "channels": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "qq": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "app_id": { "type": "string" },
                    "secret": { "type": "string", "description": "推荐 \"${QQ_BOT_SECRET}\" 插值；为空时启动报错" },
                    "allowed_users": { "type": "array", "items": { "type": "string" }, "description": "用户白名单，白名单外静默丢弃；空表示拒绝所有人，含 \"*\" 表示允许任何用户" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "providers": {
      "type": "object",
      "description": "供应商节点，键为自定义 provider_id",
      "additionalProperties": {
        "$ref": "#/definitions/provider"
      }
    }
  },
  "definitions": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["response", "anthropic", "gemini", "glm-coding-plan"],
          "description": "协议类型：response = OpenAI Responses（默认）；anthropic = Anthropic Messages；gemini = Google Gemini；glm-coding-plan = 智谱 GLM Coding Plan 预设（自动补全端点与模型）"
        },
        "base_url": {
          "type": "string",
          "description": "API 端点前缀，缺省用官方端点；未带版本后缀时自动补全 /v1 或 /v1beta"
        },
        "api_key": {
          "type": "string",
          "description": "鉴权密钥，推荐 \"${ENV_VAR}\" 插值"
        },
        "models": {
          "type": "object",
          "description": "模型清单，键为 model_id；整体省略时该供应商下任意模型名可用",
          "additionalProperties": {
            "$ref": "#/definitions/model"
          }
        }
      }
    },
    "model": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "显示名"
        },
        "type": {
          "enum": ["response", "anthropic", "gemini"],
          "description": "模型级协议覆写，缺省继承供应商 type；用于反代网关下个别模型使用不同下层协议"
        },
        "modalities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input": {
              "type": "array",
              "items": {
                "enum": ["text", "image", "video", "pdf"]
              },
              "description": "输入模态声明，附件提交时据此与协议能力双重校验"
            },
            "output": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "输出模态声明"
            }
          }
        },
        "reasoning": {
          "type": "boolean",
          "default": false,
          "description": "是否为推理模型"
        },
        "limit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["context", "output"],
          "properties": {
            "context": {
              "type": "integer",
              "description": "上下文窗口上限（tokens），用于统计面板比例展示"
            },
            "output": {
              "type": "integer",
              "description": "单轮输出上限（tokens）"
            }
          }
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "推理档位白名单，常用 minimal / low / medium / high / xhigh / max；声明后对 --variant 与 /variant 做合法性校验"
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "description": "费率（美元 / 百万 tokens），用于成本估算",
          "required": ["input", "output"],
          "properties": {
            "input": {
              "type": "number",
              "description": "普通输入 token 费率"
            },
            "output": {
              "type": "number",
              "description": "输出 token 费率"
            },
            "cache_read": {
              "type": "number",
              "description": "缓存读取费率"
            },
            "cache_write": {
              "type": "number",
              "description": "缓存写入费率"
            },
            "context_over_200k": {
              "type": "object",
              "additionalProperties": false,
              "description": "上下文超过 200k tokens 时的费率整体替换；cache 字段缺省回落基础费率",
              "required": ["input", "output"],
              "properties": {
                "input": {
                  "type": "number"
                },
                "output": {
                  "type": "number"
                },
                "cache_read": {
                  "type": "number"
                },
                "cache_write": {
                  "type": "number"
                }
              }
            }
          }
        },
        "annotation": {
          "type": "object",
          "additionalProperties": false,
          "description": "模型级注记：服务端工具声明微调与文件编辑协议",
          "properties": {
            "web_fetch": {
              "type": "boolean",
              "default": true,
              "description": "false 时不向端点声明 web_fetch 服务端工具；用于未接线该工具的中转端点（未识别条目会整组丢弃工具声明），仅声明 web_search 可保住原生搜索"
            },
            "web_search": {
              "type": "boolean",
              "default": true,
              "description": "false 标记模型/端点不支持原生 web search；会话 web 开关开启且配置 settings.web.search 时改用外置客户端工具补全"
            },
            "affinity": {
              "type": "string",
              "description": "模型亲和组：同组模型互相复用原生回传状态（response_id 链、encrypted thinking、签名块），跨组切换时历史降维为通用重建并提示。缺省为 provider 节点 id；混系网关按模型标注，如 \"gpt\""
            },
            "fast": {
              "type": "boolean",
              "description": "true 时以 \"service_tier\": \"fast\" 发起请求（快速档位端点）"
            },
            "editor": {
              "enum": ["replace", "patch", "hashline"],
              "default": "hashline",
              "description": "文件编辑协议，工具名均为 Edit，仅参数与说明不同：hashline = [PATH#TAG] 快照 + PUT/CUT/REM/MV；replace = old_string/new_string；patch = Codex V4A input。会话创建时写入并固定，不随换模改变"
            }
          }
        }
      }
    }
  }
}
